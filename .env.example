# Proveedor LLM ("gemini" | "openai" | "anthropic" | "mock")
LLM_PROVIDER=gemini

# Clave del proveedor elegido (NUNCA subir al repositorio)
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Configuración del servidor y límites de costo (Sección 8 PRD)
PORT=3000
MAX_ITERATIONS_PER_TURN=25
MAX_TOKENS_PER_SESSION=100000
LLM_TIMEOUT_MS=30000
